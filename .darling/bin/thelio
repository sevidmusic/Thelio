#!/bin/sh

# This script is replaces the `thelio` alias that was previously
# defined in `.darlingrc`

msg() {
  printf '%b%s%b' "\n\n\e[0m\e[105m\e[30m" "$1" "\e[0m\n\n"
}

msgAndExit() {
  msg "$1"
  exit 1
}

# Dissallow use of `thelio add .`
[ "${2}" = '.' ] && msg "You cannot add all files to thelio." && thelio status && msgAndExit "Please be specific about the files you wish to add"

/usr/bin/git --git-dir="${HOME}/.Thelio" --work-tree="${HOME}" "${@}"
